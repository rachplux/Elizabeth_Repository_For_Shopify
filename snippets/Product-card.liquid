<div class="w-full py-6 px-3">
            <div class="border bg-white shadow-lg rounded-lg overflow-hidden">
              <a href="{{ this_product.url }}">
                {% if this_product.featured_image %}
                  <div class="h-80 overflow-hidden">
                    <img
                      class="w-full h-full object-cover"
                      src="{{ this_product.featured_image |  img_url:'medium' }}"
                      alt="{{ this_product.feature_image.alt }}">
                  </div>
				  {% else %}
					{{ 'product-1' |  placeholder_svg_tag:'w-full h-full object-cover bg-gray-100'}}

                {% endif %}
              </a>
              <div class="flex flex-col p-4">
                <span class="text-sm text-gray-400">
                  {{ this_product.vendor }}
                </span>
                <a href="{{ this_product.url }}" class="text-gray-700 uppercase font-medium">
                  {{ this_product.title }}
                </a>
                <p class="text-gray-500">
                  {{ this_product.price | money }}
                </p>

              </div>

            </div>
          </div>