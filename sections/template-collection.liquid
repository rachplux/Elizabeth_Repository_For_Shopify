<div class="px-4 py-8">
  {% paginate collection.products by section.settings.number_of_product_per_page %}
    <h1 class="text-3xl text-center">{{ collection.title }}</h1>

    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {% for product in collection.products %}
          {% render 'product-card'
            , product_product: product %}
        {% comment %} product_product is like a function in JS, to replace 'product' {% endcomment %}
        {% else %}
          <p>There are no product inside of this collection</p>
        {% endfor %}
      </div>
    </div>

    {% render 'pagination'
      , pagination: paginate %}
  {% endpaginate %}
</div>

{% schema %}
  {
    "name": "Template Collection",
    "settings": [
      {
        "type": "number",
        "id": "number_of_product_per_page",
        "default": 6,
        "label": "Number of product per page"
      },
      {
        "type": "checkbox",
        "id": "display_vendor",
        "default": true,
        "label": "Display Vendor"
      },
      {
        "type": "checkbox",
        "id": "display_price",
        "default": true,
        "label": "Display Price"
      }
    ]
  }
{% endschema %}